<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Tarik Tambang - Barisan & Deret Aritmatika</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
  body {
    background: linear-gradient(135deg, #1e3c72, #2a5298);
    min-height: 100vh;
    color: #fff;
    padding: 20px;
  }
  h1 { text-align: center; margin-bottom: 10px; font-size: 2rem; }
  .subtitle { text-align: center; opacity: 0.85; margin-bottom: 20px; }

  .arena {
    max-width: 900px;
    margin: 0 auto;
    background: rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 25px;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 40px rgba(0,0,0,0.3);
  }

  .scoreboard {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .team {
    padding: 10px 20px;
    border-radius: 12px;
    font-weight: bold;
    font-size: 1.1rem;
    min-width: 140px;
    text-align: center;
  }
  .team.kiri { background: #2196f3; }
  .team.kanan { background: #ff5722; }
  .team.active { box-shadow: 0 0 20px #ffeb3b, 0 0 40px #ffeb3b; transform: scale(1.05); transition: all 0.3s; }
  .round-info { font-size: 1.2rem; font-weight: bold; }

  /* Arena tali tambang */
  .tambang {
    position: relative;
    height: 120px;
    background: rgba(0,0,0,0.25);
    border-radius: 15px;
    margin-bottom: 25px;
    overflow: hidden;
    border: 2px solid rgba(255,255,255,0.2);
  }
  .tali {
    position: absolute;
    top: 50%;
    left: 5%;
    right: 5%;
    height: 8px;
    background: repeating-linear-gradient(90deg, #8d6e63, #8d6e63 10px, #6d4c41 10px, #6d4c41 20px);
    transform: translateY(-50%);
    border-radius: 4px;
  }
  .pita {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 60px;
    background: linear-gradient(180deg, #ffeb3b, #fbc02d);
    transform: translate(-50%, -50%);
    border-radius: 6px;
    transition: left 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 0 15px rgba(255,235,59,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: #333;
    font-size: 1.2rem;
  }
  .garis-tengah {
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background: rgba(255,255,255,0.3);
    transform: translateX(-50%);
  }
  .zona {
    position: absolute;
    top: 0;
    height: 100%;
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    opacity: 0.3;
  }
  .zona.kiri { left: 0; }
  .zona.kanan { right: 0; }

  /* Soal */
  .soal-box {
    background: rgba(255,255,255,0.12);
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 15px;
    min-height: 180px;
  }
  .soal-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 0.95rem;
    opacity: 0.9;
  }
  .soal-teks {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 18px;
    background: rgba(0,0,0,0.2);
    padding: 15px;
    border-radius: 8px;
    border-left: 4px solid #ffeb3b;
  }
  .pilihan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .pilihan button {
    padding: 12px;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(255,255,255,0.25);
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s;
    text-align: left;
  }
  .pilihan button:hover:not(:disabled) {
    background: rgba(255,255,255,0.25);
    transform: translateY(-2px);
  }
  .pilihan button.benar { background: #4caf50 !important; border-color: #2e7d32; }
  .pilihan button.salah { background: #f44336 !important; border-color: #c62828; }
  .pilihan button:disabled { cursor: not-allowed; opacity: 0.7; }

  .feedback {
    margin-top: 15px;
    padding: 12px;
    border-radius: 8px;
    font-weight: bold;
    text-align: center;
    min-height: 20px;
  }
  .feedback.benar { background: rgba(76,175,80,0.3); }
  .feedback.salah { background: rgba(244,67,54,0.3); }

  .btn-next {
    display: block;
    margin: 15px auto 0;
    padding: 12px 30px;
    background: #ffeb3b;
    color: #333;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-next:hover { background: #fdd835; transform: translateY(-2px); }
  .btn-next:disabled { opacity: 0.5; cursor: not-allowed; }

  .akhir {
    text-align: center;
    padding: 30px;
  }
  .akhir h2 { font-size: 2rem; margin-bottom: 15px; }
  .akhir .pemenang { font-size: 1.5rem; margin: 20px 0; }
  .akhir .emoji { font-size: 4rem; margin: 15px 0; }

  @keyframes shake {
    0%,100% { transform: translate(-50%, -50%) rotate(0); }
    25% { transform: translate(-50%, -50%) rotate(-5deg); }
    75% { transform: translate(-50%, -50%) rotate(5deg); }
  }
  .pita.shake { animation: shake 0.4s; }
</style>
</head>
<body>

<h1>🏆 TARIK TAMBANG MATEMATIKA 🏆</h1>
<p class="subtitle">Barisan & Deret Aritmatika — Tim Kiri vs Tim Kanan</p>

<div class="arena">
  <div class="scoreboard">
    <div class="team kiri" id="teamKiri">⬅️ TIM KIRI</div>
    <div class="round-info" id="roundInfo">Ronde 1 / 5</div>
    <div class="team kanan" id="teamKanan">TIM KANAN ➡️</div>
  </div>

  <div class="tambang">
    <div class="zona kiri">⬅️</div>
    <div class="zona kanan">➡️</div>
    <div class="garis-tengah"></div>
    <div class="tali"></div>
    <div class="pita" id="pita">🎗️</div>
  </div>

  <div id="gameArea"></div>
</div>

<script>
/* ===== BANK SOAL =====
   5 ronde, tiap ronde punya 1 TOPIK.
   Tiap topik ada 2 soal (untuk tim kiri & tim kanan) dengan angka berbeda.
*/
const soalBank = [
  {
    topik: "Susunan Kursi Auditorium",
    kiri: {
      teks: "Di sebuah auditorium, baris pertama memiliki 12 kursi. Setiap baris di belakangnya memiliki 3 kursi lebih banyak dari baris sebelumnya. Berapa jumlah kursi pada baris ke-8?",
      pilihan: ["30", "33", "36", "39"],
      jawaban: 1 // 12 + (8-1)*3 = 33
    },
    kanan: {
      teks: "Sebuah gedung bioskop mengatur kursinya dalam barisan. Baris paling depan berisi 10 kursi, dan setiap baris berikutnya bertambah 4 kursi dari baris di depannya. Berapa banyak kursi pada baris ke-10?",
      pilihan: ["42", "46", "50", "54"],
      jawaban: 1 // 10 + (10-1)*4 = 46
    }
  },
  {
    topik: "Tabungan Rutin",
    kiri: {
      teks: "Andi menabung di celengan. Pada minggu pertama ia menabung Rp20.000. Setiap minggu berikutnya, tabungannya bertambah Rp5.000 dari minggu sebelumnya. Berapa TOTAL tabungan Andi setelah 6 minggu?",
      pilihan: ["Rp155.000", "Rp165.000", "Rp175.000", "Rp185.000"],
      jawaban: 1 // n/2(2a+(n-1)b) = 6/2(40+25) = 3*65 = 195... cek: 20+25+30+35+40+45=195. Ubah pilihan
    },
    kanan: {
      teks: "Budi menabung setiap hari. Hari pertama ia menabung Rp1.000, dan setiap hari berikutnya bertambah Rp500 dari hari sebelumnya. Berapa TOTAL tabungan Budi setelah 10 hari?",
      pilihan: ["Rp30.500", "Rp32.500", "Rp34.500", "Rp36.500"],
      jawaban: 1 // 10/2(2000+9*500) = 5(2000+4500)=5*6500=32500
    }
  },
  {
    topik: "Produksi Pabrik",
    kiri: {
      teks: "Sebuah pabrik roti memproduksi 200 roti pada hari pertama. Karena permintaan meningkat, setiap hari produksi bertambah 25 roti dari hari sebelumnya. Berapa jumlah roti yang diproduksi pada hari ke-7?",
      pilihan: ["325", "350", "375", "400"],
      jawaban: 1 // 200 + 6*25 = 350
    },
    kanan: {
      teks: "Sebuah pabrik mainan memproduksi 150 mainan pada hari pertama. Setiap hari produksi bertambah 20 mainan dari hari sebelumnya. Berapa TOTAL mainan yang diproduksi selama 8 hari?",
      pilihan: ["1.560", "1.680", "1.800", "1.920"],
      jawaban: 1 // 8/2(300+7*20)=4(300+140)=4*440=1760... koreksi
    }
  },
  {
    topik: "Pertumbuhan Tanaman",
    kiri: {
      teks: "Seorang petani menanam pohon mangga. Pada minggu pertama tingginya 40 cm. Setiap minggu tingginya bertambah 8 cm. Berapa tinggi pohon setelah minggu ke-10?",
      pilihan: ["104 cm", "112 cm", "120 cm", "128 cm"],
      jawaban: 1 // 40 + 9*8 = 112
    },
    kanan: {
      teks: "Seorang anak menanam bunga matahari. Tinggi awal tanaman 25 cm. Setiap minggu tingginya bertambah 5 cm. Berapa tinggi tanaman setelah minggu ke-12?",
      pilihan: ["75 cm", "80 cm", "85 cm", "90 cm"],
      jawaban: 1 // 25 + 11*5 = 80
    }
  },
  {
    topik: "Penduduk Desa",
    kiri: {
      teks: "Penduduk sebuah desa pada tahun 2020 berjumlah 1.500 jiwa. Setiap tahun penduduk bertambah 50 jiwa karena kelahiran lebih banyak daripada kematian. Berapa jumlah penduduk pada tahun 2028?",
      pilihan: ["1.850", "1.900", "1.950", "2.000"],
      jawaban: 1 // 1500 + 8*50 = 1900
    },
    kanan: {
      teks: "Sebuah desa memiliki 2.000 penduduk pada tahun 2019. Setiap tahun bertambah 75 jiwa. Berapa jumlah penduduk pada tahun 2027?",
      pilihan: ["2.525", "2.600", "2.675", "2.750"],
      jawaban: 1 // 2000 + 8*75 = 2600
    }
  }
];

// Koreksi jawaban yang salah hitung
soalBank[1].kiri.jawaban = 3; // 20+25+30+35+40+45 = 195 -> pilihan ke-3 (indeks 3 = 185? tidak, ubah)
// Mari hitung ulang dan perbaiki:
soalBank[1].kiri = {
  teks: "Andi menabung di celengan. Pada minggu pertama ia menabung Rp20.000. Setiap minggu berikutnya, tabungannya bertambah Rp5.000 dari minggu sebelumnya. Berapa TOTAL tabungan Andi setelah 6 minggu?",
  pilihan: ["Rp155.000", "Rp175.000", "Rp195.000", "Rp215.000"],
  jawaban: 2 // 6/2(40+25)=195
};
soalBank[2].kanan = {
  teks: "Sebuah pabrik mainan memproduksi 150 mainan pada hari pertama. Setiap hari produksi bertambah 20 mainan dari hari sebelumnya. Berapa TOTAL mainan yang diproduksi selama 8 hari?",
  pilihan: ["1.560", "1.680", "1.760", "1.880"],
  jawaban: 2 // 8/2(300+140)=4*440=1760
};

/* ===== LOGIKA GAME ===== */
let ronde = 0;          // 0..4
let giliran = 'kiri';   // 'kiri' atau 'kanan'
let posisi = 0;         // -5 s.d. +5 (negatif = ke kiri, positif = ke kanan)
const gameArea = document.getElementById('gameArea');
const pita = document.getElementById('pita');
const roundInfo = document.getElementById('roundInfo');
const teamKiri = document.getElementById('teamKiri');
const teamKanan = document.getElementById('teamKanan');

function updateTali() {
  // posisi -5..+5 -> persentase 5%..95%
  const persen = 50 + posisi * 9; // tiap poin = 9%
  pita.style.left = persen + '%';
  pita.classList.add('shake');
  setTimeout(() => pita.classList.remove('shake'), 400);
}

function highlightTeam() {
  teamKiri.classList.toggle('active', giliran === 'kiri');
  teamKanan.classList.toggle('active', giliran === 'kanan');
}

function tampilkanSoal() {
  const data = soalBank[ronde][giliran];
  roundInfo.textContent = `Ronde ${ronde+1} / 5 — Giliran Tim ${giliran.toUpperCase()}`;
  highlightTeam();

  gameArea.innerHTML = `
    <div class="soal-box">
      <div class="soal-header">
        <span><b>📚 Topik:</b> ${soalBank[ronde].topik}</span>
        <span>Soal untuk <b>Tim ${giliran.toUpperCase()}</b></span>
      </div>
      <div class="soal-teks">${data.teks}</div>
      <div class="pilihan" id="pilihanArea">
        ${data.pilihan.map((p,i) => `<button data-idx="${i}">${String.fromCharCode(65+i)}. ${p}</button>`).join('')}
      </div>
      <div class="feedback" id="feedback"></div>
      <button class="btn-next" id="btnNext" disabled>Lanjut ➡️</button>
    </div>
  `;

  document.querySelectorAll('#pilihanArea button').forEach(btn => {
    btn.addEventListener('click', () => jawab(btn, data.jawaban));
  });
  document.getElementById('btnNext').addEventListener('click', lanjut);
}

function jawab(btn, idxBenar) {
  const buttons = document.querySelectorAll('#pilihanArea button');
  buttons.forEach(b => b.disabled = true);
  const feedback = document.getElementById('feedback');
  const dipilih = parseInt(btn.dataset.idx);

  if (dipilih === idxBenar) {
    btn.classList.add('benar');
    feedback.className = 'feedback benar';
    if (giliran === 'kiri') {
      posisi -= 1; // tali ke kiri
      feedback.textContent = '✅ BENAR! Tali bergerak ke TIM KIRI!';
    } else {
      posisi += 1; // tali ke kanan
      feedback.textContent = '✅ BENAR! Tali bergerak ke TIM KANAN!';
    }
  } else {
    btn.classList.add('salah');
    buttons[idxBenar].classList.add('benar');
    feedback.className = 'feedback salah';
    if (giliran === 'kiri') {
      posisi += 1; // salah -> tali ke kanan
      feedback.textContent = '❌ SALAH! Tali malah bergerak ke TIM KANAN!';
    } else {
      posisi -= 1; // salah -> tali ke kiri
      feedback.textContent = '❌ SALAH! Tali malah bergerak ke TIM KIRI!';
    }
  }
  updateTali();
  document.getElementById('btnNext').disabled = false;
}

function lanjut() {
  if (giliran === 'kiri') {
    giliran = 'kanan';
    tampilkanSoal();
  } else {
    // selesai 1 ronde
    giliran = 'kiri';
    ronde++;
    if (ronde >= 5) {
      tampilkanHasil();
    } else {
      tampilkanSoal();
    }
  }
}

function tampilkanHasil() {
  roundInfo.textContent = 'SELESAI!';
  teamKiri.classList.remove('active');
  teamKanan.classList.remove('active');

  let emoji, pesan, warna;
  if (posisi < 0) {
    emoji = '🎉⬅️🏆';
    pesan = 'TIM KIRI MENANG!';
    warna = '#2196f3';
  } else if (posisi > 0) {
    emoji = '🏆➡️🎉';
    pesan = 'TIM KANAN MENANG!';
    warna = '#ff5722';
  } else {
    emoji = '🤝';
    pesan = 'SERI! KEDUA TIM HEBAT!';
    warna = '#ffeb3b';
  }

  gameArea.innerHTML = `
    <div class="akhir">
      <div class="emoji">${emoji}</div>
      <h2 style="color:${warna}">PERTANDINGAN SELESAI!</h2>
      <div class="pemenang" style="color:${warna}">${pesan}</div>
      <p>Posisi akhir tali: <b>${posisi > 0 ? '+' : ''}${posisi}</b> (skala -5 s.d. +5)</p>
      <button class="btn-next" onclick="location.reload()">🔄 Main Lagi</button>
    </div>
  `;
}

// Mulai
updateTali();
tampilkanSoal();
</script>
</body>
</html>
